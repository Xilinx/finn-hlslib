# Tcl script for HLS csim, synthesis and cosim of the binary-search thresholding.
# The configuration in thresholding_top.hpp is generated by thresholding_gen.py.

open_project hls-syn-thresholding
add_files thresholding_top.cpp -cflags "-std=c++14 -I$::env(FINN_HLS_ROOT) -I$::env(FINN_HLS_ROOT)/tb"
add_files -tb thresholding_tb.cpp -cflags "-std=c++14 -I$::env(FINN_HLS_ROOT) -I$::env(FINN_HLS_ROOT)/tb"
set_top thresholding_top
open_solution sol1
set_part xczu7ev-ffvc1156-2-e
create_clock -period 3.333 -name default
csim_design
csynth_design
cosim_design
exit
